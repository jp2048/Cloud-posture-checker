# Copy to .env and fill in (or export these variables directly).
# The tool also works with the SDK default chains:
#   Azure: `az login`, managed identity, or service-principal env vars
#   AWS:   ~/.aws/credentials, SSO, or an attached IAM role

# Azure
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000

# AWS
AWS_REGION=us-east-1
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
